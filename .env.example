# Telegram bot token from @BotFather (leave empty to run the REST API only)
TELEGRAM_BOT_TOKEN=
# Telegram user IDs allowed to upload documents, JSON list
ADMIN_IDS=[123456789]
# Secret for the admin REST API (X-API-Key header)
ADMIN_API_TOKEN=change-me

# Chat model: any OpenAI-compatible API (DeepSeek, OpenAI, Qwen, GLM, Kimi...)
CHAT_BASE_URL=https://api.deepseek.com
CHAT_API_KEY=
CHAT_MODEL=deepseek-chat

# Embedding model: any OpenAI-compatible embeddings API
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=
EMBED_MODEL=BAAI/bge-m3
